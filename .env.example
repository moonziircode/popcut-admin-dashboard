# ==========================================
# POPCUT.ID ADMIN DASHBOARD ENVIRONMENT CONFIG
# ==========================================

# 1. Supabase Public Config (Client & SSR Safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 2. Supabase Server-Only Secret Config (NEVER expose to client/browser!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_WEBHOOK_SECRET=your-webhook-secret

# 3. Application URL & Timezone
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BUSINESS_TIMEZONE=Asia/Jakarta
NEXT_PUBLIC_CURRENCY=IDR

# 4. Midtrans Payment Gateway
MIDTRANS_SERVER_KEY=your-midtrans-server-key
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=your-midtrans-client-key
MIDTRANS_SANDBOX_SERVER_KEY=your-midtrans-sandbox-server-key
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_MERCHANT_NAME=Popcut.id
