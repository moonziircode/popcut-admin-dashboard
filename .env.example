# ==========================================
# POPCUT.ID ADMIN DASHBOARD ENVIRONMENT CONFIG
# ==========================================

# 1. Supabase Public Config (Client & SSR Safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 2. Supabase Server-Only Secret Config (NEVER expose to client/browser!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_WEBHOOK_SECRET=your-webhook-secret

# 3. Application URL & Timezone
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BUSINESS_TIMEZONE=Asia/Jakarta
NEXT_PUBLIC_CURRENCY=IDR
